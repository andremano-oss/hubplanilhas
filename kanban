<!DOCTYPE html>
<html lang="pt-BR" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão 5W2H Kanban • Google Sheets</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        [draggable="true"] { cursor: grab; }
        [draggable="true"]:active { cursor: grabbing; }
        .drag-over { background-color: rgba(59, 130, 246, 0.05); border: 2px dashed #3b82f6 !important; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 h-full flex flex-col overflow-hidden">

    <div id="app" class="flex h-full w-full overflow-hidden">
        
        <!-- Sidebar: Projetos e Pastas -->
        <aside id="sidebar" class="w-80 bg-slate-900 text-slate-100 flex flex-col flex-shrink-0 transition-all duration-300 z-20">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="bg-blue-600 text-white p-2 rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                        <i class="fa-solid fa-table-cells text-lg"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-base tracking-wide">Kanban 5W2H</h1>
                        <p class="text-xs text-slate-400">Google Sheets Sync</p>
                    </div>
                </div>
            </div>

            <!-- Botões de Ação Rápida e Sincronização -->
            <div class="p-3 border-b border-slate-800 space-y-2">
                <div class="flex gap-2">
                    <button onclick="openProjectModal()" class="flex-1 bg-blue-600 hover:bg-blue-500 text-white text-xs font-medium py-2 px-3 rounded-lg shadow transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-plus"></i> Novo Projeto
                    </button>
                    <button onclick="openFolderModal()" class="flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium py-2 px-3 rounded-lg border border-slate-700 transition flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-folder-plus text-blue-400"></i> Nova Pasta
                    </button>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <button onclick="syncWithCloud()" id="sync-btn" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium py-2 px-3 rounded-lg border border-slate-700 transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-rotate text-emerald-400" id="sync-icon"></i> <span id="sync-text">Sincronizar Planilha</span>
                    </button>
                </div>
            </div>

            <!-- Árvore de Projetos e Pastas -->
            <div id="sidebar-tree" class="flex-1 overflow-y-auto p-3 space-y-3 custom-scrollbar">
                <!-- Preenchido via JavaScript -->
            </div>

            <!-- Rodapé Sidebar -->
            <div class="p-3 border-t border-slate-800 text-[11px] text-slate-500 text-center flex items-center justify-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block" id="status-dot"></span>
                <span id="status-text">Conectado ao Sheets</span>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col overflow-hidden bg-slate-100 relative">
            
            <!-- Top Header -->
            <header class="bg-white border-b border-slate-200 h-16 px-6 flex items-center justify-between flex-shrink-0 shadow-sm z-10">
                <div class="flex items-center space-x-4">
                    <button onclick="toggleSidebar()" class="text-slate-500 hover:text-slate-700 p-2 rounded-lg hover:bg-slate-100 transition">
                        <i class="fa-solid fa-bars text-lg"></i>
                    </button>
                    <div>
                        <h2 id="current-title" class="font-bold text-lg text-slate-800">Selecione um projeto ou pasta</h2>
                        <p id="current-subtitle" class="text-xs text-slate-500">Nenhum item selecionado</p>
                    </div>
                </div>

                <div class="flex items-center space-x-3" id="project-actions" style="display: none;">
                    <button onclick="openColumnModal()" class="bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 text-sm font-medium py-2 px-4 rounded-xl transition flex items-center gap-2 shadow-sm">
                        <i class="fa-solid fa-columns text-slate-500"></i> Gerenciar Etapas
                    </button>
                    <button onclick="openCardModal()" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-xl shadow-md shadow-blue-500/20 transition flex items-center gap-2">
                        <i class="fa-solid fa-plus"></i> Novo Card 5W2H
                    </button>
                </div>
            </header>

            <!-- Kanban Board Container -->
            <div id="kanban-container" class="flex-1 overflow-x-auto overflow-y-hidden p-6 custom-scrollbar flex items-start space-x-6">
                <!-- Estado Vazio Inicial -->
                <div class="w-full h-full flex flex-col items-center justify-center text-slate-400">
                    <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 text-center max-w-md">
                        <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner">
                            <i class="fa-solid fa-table-cells"></i>
                        </div>
                        <h3 class="font-semibold text-slate-700 text-lg mb-1">Nenhum item selecionado</h3>
                        <p class="text-sm text-slate-500 mb-6">Escolha uma pasta dentro de um projeto na barra lateral para ver o Kanban 5W2H.</p>
                        <button onclick="openProjectModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-xl transition shadow-md shadow-blue-500/20 text-sm">
                            Criar Primeiro Projeto
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal: Criar/Editar Projeto -->
    <div id="project-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h3 id="project-modal-title" class="font-bold text-slate-800 text-lg">Novo Projeto</h3>
                <button onclick="closeProjectModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="handleProjectSubmit(event)" class="p-6 space-y-4">
                <input type="hidden" id="project-id">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nome do Projeto Principal</label>
                    <input type="text" id="project-name" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ex: Expansão Comercial 2026">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Descrição</label>
                    <textarea id="project-desc" rows="2" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Resumo do projeto..."></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeProjectModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancelar</button>
                    <button type="submit" class="px-5 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md transition">Salvar Projeto</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Criar/Editar Pasta -->
    <div id="folder-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h3 id="folder-modal-title" class="font-bold text-slate-800 text-lg">Nova Pasta</h3>
                <button onclick="closeFolderModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <form onsubmit="handleFolderSubmit(event)" class="p-6 space-y-4">
                <input type="hidden" id="folder-id">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Projeto Pai</label>
                    <select id="folder-project-id" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <!-- Preenchido via JS -->
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Nome da Pasta</label>
                    <input type="text" id="folder-name" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ex: Marketing, Logística...">
                </div>
                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeFolderModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancelar</button>
                    <button type="submit" class="px-5 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md transition">Salvar Pasta</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Gerenciar Etapas (Colunas) -->
    <div id="column-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden transform transition-all">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <h3 class="font-bold text-slate-800 text-lg">Gerenciar Etapas do Kanban</h3>
                <button onclick="closeColumnModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="p-6 space-y-5">
                <form onsubmit="addColumn(event)" class="flex gap-2">
                    <input type="text" id="new-col-name" required placeholder="Nova etapa (ex: Em Revisão)..." class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-medium transition shadow-sm">Adicionar</button>
                </form>
                <div>
                    <h4 class="text-xs font-semibold text-slate-500 uppercase mb-3">Etapas Atuais desta Pasta</h4>
                    <div id="columns-list" class="space-y-2 max-h-60 overflow-y-auto custom-scrollbar pr-1">
                        <!-- Renderizado via JS -->
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end">
                <button onclick="closeColumnModal()" class="px-5 py-2 text-sm font-medium bg-slate-800 hover:bg-slate-700 text-white rounded-xl transition">Concluir</button>
            </div>
        </div>
    </div>

    <!-- Modal: Card 5W2H (Criar/Editar) -->
    <div id="card-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-shrink-0">
                <h3 id="card-modal-title" class="font-bold text-slate-800 text-lg flex items-center gap-2">
                    <i class="fa-solid fa-file-lines text-blue-600"></i> Novo Card 5W2H
                </h3>
                <button onclick="closeCardModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <form onsubmit="handleCardSubmit(event)" class="p-6 overflow-y-auto space-y-5 custom-scrollbar flex-1">
                <input type="hidden" id="card-id">
                
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div class="md:col-span-3">
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Título da Tarefa *</label>
                        <input type="text" id="card-title" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ex: Contratar nova ferramenta de anúncios">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Prioridade</label>
                        <select id="card-priority" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium">
                            <option value="baixa">Baixa</option>
                            <option value="media" selected>Média</option>
                            <option value="alta">Alta</option>
                            <option value="urgente">Urgente</option>
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Pasta Destino</label>
                        <select id="card-folder-id" onchange="updateCardColumns()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <!-- Preenchido via JS -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Etapa Kanban</label>
                        <select id="card-column" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <!-- Preenchido via JS -->
                        </select>
                    </div>
                </div>

                <!-- 5W2H Grid -->
                <div class="bg-blue-50/50 border border-blue-100 p-4 rounded-2xl space-y-4">
                    <div class="flex items-center space-x-2 text-blue-800 font-semibold text-sm pb-1 border-b border-blue-200">
                        <i class="fa-solid fa-circle-question"></i>
                        <span>Metodologia 5W2H (Planejamento)</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">1. What (O que será feito?)</label>
                            <textarea id="w-what" rows="2" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Descreva a ação..."></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">2. Why (Por que será feito?)</label>
                            <textarea id="w-why" rows="2" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Justificativa / Objetivo..."></textarea>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">3. Where (Onde será executado?)</label>
                            <input type="text" id="w-where" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Local / Setor / Sistema...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">4. When (Quando / Prazo?)</label>
                            <input type="date" id="w-when" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">5. Who (Quem fará? - Responsável)</label>
                            <input type="text" id="w-who" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Nome ou equipe...">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 uppercase mb-1">6. How (Como será feito? - Método)</label>
                            <input type="text" id="w-how" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Passo a passo...">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase mb-1">7. How Much (Quanto custará?)</label>
                        <input type="text" id="w-howmuch" class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ex: R$ 1.200,00 ou 10h...">
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-2">
                    <button type="button" onclick="closeCardModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancelar</button>
                    <button type="submit" class="px-5 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md transition">Salvar Card</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Visualizar Card Completo -->
    <div id="view-card-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl overflow-hidden transform transition-all flex flex-col max-h-[95vh]">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-shrink-0 bg-slate-50">
                <div class="flex items-center space-x-2">
                    <span id="v-badge" class="bg-blue-100 text-blue-700 text-xs font-semibold px-2.5 py-1 rounded-lg">Etapa</span>
                    <span id="v-priority-badge" class="text-xs font-semibold px-2.5 py-1 rounded-lg">Prioridade</span>
                    <h3 id="v-title" class="font-bold text-slate-800 text-lg">Título da Tarefa</h3>
                </div>
                <button onclick="closeViewCardModal()" class="text-slate-400 hover:text-slate-600 p-1 rounded-lg"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            
            <div class="p-6 overflow-y-auto space-y-4 custom-scrollbar flex-1 bg-slate-50/50">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">1. What (O quê)</span>
                        <p id="v-what" class="text-sm text-slate-700 whitespace-pre-line">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">2. Why (Por quê)</span>
                        <p id="v-why" class="text-sm text-slate-700 whitespace-pre-line">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">3. Where (Onde)</span>
                        <p id="v-where" class="text-sm text-slate-700">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">4. When (Quando)</span>
                        <p id="v-when" class="text-sm text-slate-700">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">5. Who (Quem)</span>
                        <p id="v-who" class="text-sm text-slate-700">-</p>
                    </div>
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">6. How (Como)</span>
                        <p id="v-how" class="text-sm text-slate-700">-</p>
                    </div>
                </div>
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-[10px] font-bold tracking-wider text-blue-600 uppercase block mb-1">7. How Much (Custo)</span>
                    <p id="v-howmuch" class="text-sm text-slate-700">-</p>
                </div>
            </div>

            <div class="px-6 py-4 bg-white border-t border-slate-100 flex justify-between items-center">
                <button id="v-btn-delete" class="text-rose-600 hover:text-rose-700 text-sm font-medium flex items-center gap-1.5 px-3 py-2 rounded-lg hover:bg-rose-50 transition">
                    <i class="fa-solid fa-trash"></i> Excluir Card
                </button>
                <div class="flex gap-2">
                    <button id="v-btn-edit" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-medium px-4 py-2 rounded-xl transition flex items-center gap-1.5">
                        <i class="fa-solid fa-pen"></i> Editar
                    </button>
                    <button onclick="closeViewCardModal()" class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-5 py-2 rounded-xl transition shadow-md">Fechar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Custom Dialog -->
    <div id="custom-dialog" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm overflow-hidden p-6 space-y-4 transform transition-all">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-amber-100 flex items-center justify-center text-amber-600">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 id="dialog-title" class="font-bold text-slate-800 text-lg">Aviso</h3>
            </div>
            <p id="dialog-message" class="text-sm text-slate-600">Mensagem do sistema.</p>
            <div class="flex justify-end gap-3 pt-2" id="dialog-actions">
                <!-- Actions injected via JS -->
            </div>
        </div>
    </div>

    <script>
        const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbzrJOK5eaf97lxnYBxwC-nGQR9xJFgIOpFKUU5CM3l0psTP7FHuokIPMIwfCMAI4u6Z/exec";

        let appData = {
            projects: [],
