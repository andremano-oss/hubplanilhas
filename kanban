        function handleFolderSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('folder-id').value;
            const projectId = document.getElementById('folder-project-id').value;
            const name = document.getElementById('folder-name').value;

            const targetProj = appData.projects.find(p => String(p.id) === String(projectId));
            if (!targetProj) return;

            if (id) {
                let oldProj = null;
                let oldFolder = null;
                let oldFolderIndex = -1;
                
                appData.projects.forEach(p => {
                    const idx = p.folders.findIndex(f => String(f.id) === String(id));
                    if (idx !== -1) {
                        oldProj = p;
                        oldFolder = p.folders[idx];
                        oldFolderIndex = idx;
                    }
                });

                if (oldFolder) {
                    oldFolder.name = name;
                    // Se o projeto destino for diferente, movemos a pasta
                    if (String(oldProj.id) !== String(projectId)) {
                        oldProj.folders.splice(oldFolderIndex, 1);
                        targetProj.folders.push(oldFolder);
                    }
                }
            } else {
                const newFolder = {
                    id: 'folder-' + Date.now(),
                    name: name,
                    stages: [
                        { id: 'col-1', name: 'A Fazer' },
                        { id: 'col-2', name: 'Em Andamento' },
                        { id: 'col-3', name: 'Concluído' }
                    ],
                    cards: []
                };
                targetProj.folders.push(newFolder);
                appData.currentFolderId = newFolder.id;
            }

            saveLocalAndCloud();
            renderSidebar();
            if (appData.currentFolderId) loadFolder(appData.currentFolderId);
            closeFolderModal();
        }

