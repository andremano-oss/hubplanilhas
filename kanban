        document.addEventListener('DOMContentLoaded', () => {
            loadFromLocalStorage();
            syncWithCloud();
        });

        function loadFromLocalStorage() {
            const saved = localStorage.getItem('kanban_5w2h_sheets_data');
            if (saved) {
                try {
                    appData = JSON.parse(saved);
                    renderSidebar();
                    if (appData.currentFolderId) {
                        loadFolder(appData.currentFolderId);
                    } else if (appData.projects.length > 0 && appData.projects[0].folders.length > 0) {
                        loadFolder(appData.projects[0].folders[0].id);
                    }
                } catch(e) {}
            }
        }

        function saveLocalAndCloud() {
            localStorage.setItem('kanban_5w2h_sheets_data', JSON.stringify(appData));
            pushToCloud();
        }

        async function syncWithCloud() {
            if (!WEB_APP_URL || WEB_APP_URL.includes("COLE_AQUI")) {
                showStatus("URL do Apps Script não configurada", "error");
                return;
            }

            showStatus("Sincronizando...", "sync");

            try {
                const response = await fetch(WEB_APP_URL);
                const result = await response.json();

                if (result.status === "success") {
                    if (result.projects && result.projects.length > 0) {
                        appData.projects = result.projects;
                        if (!appData.currentFolderId && appData.projects[0]?.folders[0]) {
                            appData.currentFolderId = appData.projects[0].folders[0].id;
                        }
                    } else if (appData.projects.length > 0) {
                        pushToCloud();
                        return;
                    }
                    localStorage.setItem('kanban_5w2h_sheets_data', JSON.stringify(appData));
                    renderSidebar();
                    if (appData.currentFolderId) loadFolder(appData.currentFolderId);
                    showStatus("Sincronizado com a Planilha", "success");
                } else {
                    showStatus("Erro ao ler planilha", "error");
                }
            } catch (err) {
                showStatus("Modo Offline / Local ativo", "error");
                console.warn(err);
            }
        }

        async function pushToCloud() {
            if (!WEB_APP_URL || WEB_APP_URL.includes("COLE_AQUI")) return;

            showStatus("Salvando na nuvem...", "sync");

            try {
                await fetch(WEB_APP_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify({
                        action: 'save_all',
                        projects: appData.projects
                    })
                });
                showStatus("Salvo na Planilha", "success");
            } catch (err) {
                showStatus("Salvo Localmente (Erro nuvem)", "error");
                console.error(err);
            }
        }

        function showStatus(text, type) {
            const dot = document.getElementById('status-dot');
            const label = document.getElementById('status-text');
            const icon = document.getElementById('sync-icon');

            if (!label) return;
            label.textContent = text;
            if (type === "success") {
                dot.className = "w-2 h-2 rounded-full bg-emerald-500 inline-block";
                if(icon) icon.className = "fa-solid fa-rotate text-emerald-400";
            } else if (type === "sync") {
                dot.className = "w-2 h-2 rounded-full bg-amber-500 inline-block animate-pulse";
                if(icon) icon.className = "fa-solid fa-rotate text-amber-400 animate-spin";
            } else {
                dot.className = "w-2 h-2 rounded-full bg-rose-500 inline-block";
                if(icon) icon.className = "fa-solid fa-rotate text-rose-400";
            }
        }

