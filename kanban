            if (!folder) return;
            
            showDialog('Excluir Card', 'Deseja excluir permanentemente esta tarefa?', true, (confirmed) => {
                if (confirmed) {
                    folder.cards = folder.cards.filter(c => String(c.id) !== String(cardId));
                    saveLocalAndCloud();
                    closeViewCardModal();
                    closeCardModal();
                    renderKanban(folder);
                }
