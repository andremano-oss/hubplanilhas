        // --- Dialog System ---
        let dialogCallback = null;
        function showDialog(title, message, isConfirm, callback) {
            document.getElementById('dialog-title').textContent = title;
            document.getElementById('dialog-message').textContent = message;
            const actions = document.getElementById('dialog-actions');
            
            if (isConfirm) {
                actions.innerHTML = `
                    <button onclick="closeDialog(false)" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100 rounded-xl transition">Cancelar</button>
                    <button onclick="closeDialog(true)" class="px-5 py-2 text-sm font-medium bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow-md transition">Confirmar</button>
                `;
            } else {
                 actions.innerHTML = `
                    <button onclick="closeDialog(true)" class="px-5 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md transition">OK</button>
                `;
            }
            dialogCallback = callback;
            document.getElementById('custom-dialog').classList.remove('hidden');
        }

        function closeDialog(result) {
            document.getElementById('custom-dialog').classList.add('hidden');
            if (dialogCallback) {
                dialogCallback(result);
                dialogCallback = null;
            }
        }
