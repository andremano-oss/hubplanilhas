        function handleCardSubmit(e) {
            e.preventDefault();
            
            const id = document.getElementById('card-id').value;
            const targetFolderId = document.getElementById('card-folder-id').value;
            const columnId = document.getElementById('card-column').value;
            
            const cardData = {
                id: id || 'card-' + Date.now(),
                columnId: columnId,
                title: document.getElementById('card-title').value,
                priority: document.getElementById('card-priority').value,
                what: document.getElementById('w-what').value,
                why: document.getElementById('w-why').value,
                where: document.getElementById('w-where').value,
                when: document.getElementById('w-when').value,
                who: document.getElementById('w-who').value,
                how: document.getElementById('w-how').value,
                howmuch: document.getElementById('w-howmuch').value
            };

            let targetFolder = null;
            appData.projects.forEach(p => {
                const f = p.folders.find(f => String(f.id) === String(targetFolderId));
                if (f) targetFolder = f;
            });

            if (!targetFolder) return;

            if (id) {
                // Card já existe, verificar se mudou de pasta
                let oldFolder = getCurrentFolder(); // assume que estamos na pasta atual
                
                if (String(oldFolder.id) !== String(targetFolderId)) {
                    // Remove da pasta antiga
                    oldFolder.cards = oldFolder.cards.filter(c => String(c.id) !== String(id));
                    // Adiciona na nova pasta
                    targetFolder.cards.push(cardData);
                } else {
                    // Atualiza na mesma pasta
                    const idx = targetFolder.cards.findIndex(c => String(c.id) === String(id));
                    if (idx !== -1) targetFolder.cards[idx] = cardData;
                }
            } else {
                // Novo card
                targetFolder.cards.push(cardData);
            }

            saveLocalAndCloud();
            // Atualiza a visualização apenas se ainda estivermos visualizando a mesma pasta onde a ação ocorreu
            const curr = getCurrentFolder();
            if (curr) renderKanban(curr);
            
            closeCardModal();
        }

        function getCurrentFolder() {
            if (!appData.currentFolderId) return null;
            let found = null;
            appData.projects.forEach(p => {
                const f = p.folders.find(folder => String(folder.id) === String(appData.currentFolderId));
                if (f) found = f;
            });
            return found;
        }

