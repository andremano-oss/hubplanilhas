                case 'baixa': return 'bg-slate-100 text-slate-600 border-slate-200';
                case 'media':
                default: return 'bg-blue-50 text-blue-700 border-blue-200';
            }
        }

        function getPriorityLabel(priority) {
            switch(priority) {
                case 'urgente': return 'Urgente';
