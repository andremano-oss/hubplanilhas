        }

        function viewCardDetails(cardId) {
            const folder = getCurrentFolder();
            if (!folder) return;
            const card = folder.cards.find(c => String(c.id) === String(cardId));
            if (!card) return;
            const stage = folder.stages.find(s => String(s.id) === String(card.columnId));

            document.getElementById('v-title').textContent = card.title;
            document.getElementById('v-badge').textContent = stage ? stage.name : 'Etapa';
            
            const priorityBadge = document.getElementById('v-priority-badge');
            priorityBadge.className = `text-xs font-semibold px-2.5 py-1 rounded-lg border ${getPriorityBadgeStyle(card.priority)}`;
            priorityBadge.textContent = `Prioridade: ${getPriorityLabel(card.priority)}`;

            document.getElementById('v-what').textContent = card.what || 'Não informado';
            document.getElementById('v-why').textContent = card.why || 'Não informado';
            document.getElementById('v-where').textContent = card.where || 'Não informado';
            document.getElementById('v-when').textContent = card.when || 'Não informado';
            document.getElementById('v-who').textContent = card.who || 'Não informado';
            document.getElementById('v-how').textContent = card.how || 'Não informado';
            document.getElementById('v-howmuch').textContent = card.howmuch || 'Não informado';

            document.getElementById('v-btn-edit').onclick = () => { closeViewCardModal(); openCardModal(card.id); };
            
            const deleteBtn = document.getElementById('v-btn-delete');
            deleteBtn.onclick = function(e) {
                deleteCard(e, card.id);
            };

            document.getElementById('view-card-modal').classList.remove('hidden');
        }

        function closeViewCardModal() {
            document.getElementById('view-card-modal').classList.add('hidden');
        }

        function renderKanban(folder) {
            const container = document.getElementById('kanban-container');
            if (!container) return;
            container.innerHTML = folder.stages.map(col => {
                const colCards = folder.cards.filter(c => String(c.columnId) === String(col.id));
                return `
                    <div class="w-80 flex-shrink-0 bg-slate-200/60 rounded-2xl flex flex-col max-h-full border border-slate-200/80 shadow-sm"
                         ondragover="allowDrop(event)" ondragleave="removeDropStyle(event)" ondrop="dropCard(event, '${col.id}')">
                        <div class="p-4 flex items-center justify-between flex-shrink-0">
                            <div class="flex items-center space-x-2">
                                <span class="w-3 h-3 rounded-full bg-blue-600"></span>
                                <h3 class="font-bold text-slate-700 text-sm">${col.name}</h3>
                                <span class="bg-slate-300 text-slate-700 text-xs font-bold px-2 py-0.5 rounded-full">${colCards.length}</span>
                            </div>
                            <button onclick="openCardModal()" class="text-slate-400 hover:text-blue-600 p-1 rounded-lg transition"><i class="fa-solid fa-plus"></i></button>
                        </div>

                        <div class="flex-1 overflow-y-auto px-3 pb-3 space-y-3 custom-scrollbar">
                            ${colCards.length === 0 ? `
                                <div class="text-center py-8 border-2 border-dashed border-slate-300/60 rounded-xl text-slate-400 text-xs">
                                    Nenhum card
                                </div>
                            ` : colCards.map(card => `
                                <div draggable="true" ondragstart="dragCard(event, '${card.id}')" onclick="viewCardDetails('${card.id}')"
                                     class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 hover:shadow-md hover:border-blue-300 transition group relative cursor-pointer space-y-2">
                                    <div class="flex items-start justify-between">
                                        <h4 class="font-semibold text-slate-800 text-sm pr-6 leading-snug">${card.title}</h4>
                                        <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition flex gap-1 bg-white pl-2">
                                            <button onclick="event.stopPropagation(); openCardModal('${card.id}')" class="text-slate-400 hover:text-blue-600 p-1"><i class="fa-solid fa-pen text-xs"></i></button>
                                            <button onclick="event.stopPropagation(); deleteCard(event, '${card.id}')" class="text-slate-400 hover:text-rose-600 p-1"><i class="fa-solid fa-trash text-xs"></i></button>
                                        </div>
                                    </div>
                                    <div class="flex flex-wrap gap-1.5 items-center">
                                        <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md border ${getPriorityBadgeStyle(card.priority)}">
                                            ${getPriorityLabel(card.priority)}
                                        </span>
                                    </div>
                                    ${card.what ? `<p class="text-xs text-slate-500 line-clamp-2">${card.what}</p>` : ''}
                                    <div class="flex flex-wrap gap-1.5 pt-1 border-t border-slate-100">
                                        ${card.who ? `<span class="bg-slate-100 text-slate-600 text-[10px] px-2 py-0.5 rounded-md flex items-center gap-1"><i class="fa-solid fa-user text-[9px]"></i> ${card.who}</span>` : ''}
                                        ${card.when ? `<span class="bg-blue-50 text-blue-700 text-[10px] px-2 py-0.5 rounded-md flex items-center gap-1"><i class="fa-regular fa-calendar text-[9px]"></i> ${card.when}</span>` : ''}
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
            }).join('');
        }

        let draggedCardId = null;

        function dragCard(e, cardId) {
            draggedCardId = cardId;
            e.dataTransfer.setData('text/plain', cardId);
        }

        function allowDrop(e) {
            e.preventDefault();
            e.currentTarget.classList.add('drag-over');
        }

        function removeDropStyle(e) {
            e.currentTarget.classList.remove('drag-over');
        }

        function dropCard(e, targetColId) {
            e.preventDefault();
            e.currentTarget.classList.remove('drag-over');
            const folder = getCurrentFolder();
            if (!folder || !draggedCardId) return;

            const card = folder.cards.find(c => String(c.id) === String(draggedCardId));
            if (card) {
                card.columnId = targetColId;
                saveLocalAndCloud();
                renderKanban(folder);
            }
            draggedCardId = null;
        }
    </script>
</body>
</html>
